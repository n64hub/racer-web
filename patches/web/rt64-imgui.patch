+//
+// RT64
+//
+
+#pragma once
+
+#include "shared/rt64_f3d_defines.h"
+#include "shared/rt64_formats.h"
+
+#ifdef HLSL_CPU
+namespace interop {
+#endif
+
+#define TMEM_RDP_BYTES 0x1000
+#define TMEM_RDP_PALETTE 0x800
+#define TMEM_RDP_MASK8 0xFFF
+#define TMEM_RDP_MASK16 0x7FF
+
+#ifdef HLSL_CPU
+#define TMEM_TEXTURE_TYPE const uint8_t*
+#define TMEM_TEXTURE_LOAD(tmem, coord) tmem[coord.x]
+#define HLSL_AND(a, b) (a && b)
+#define HLSL_OR(a, b) (a || b)
+#elif defined(TMEM_SOURCE)
+// TMEM is a 1D R8_UINT texture unless the includer reads it from somewhere else (FbRendererCommon.hlsli).
+#define TMEM_TEXTURE_TYPE TMEM_SOURCE
+#define TMEM_TEXTURE_LOAD(tmem, coord) TMEM_LOAD(tmem, uint((coord).x))
+#define HLSL_AND(a, b) and(a, b)
+#define HLSL_OR(a, b) or(a, b)
+#else
+#define TMEM_TEXTURE_TYPE Texture1D<uint>
+#define TMEM_TEXTURE_LOAD(tmem, coord) tmem.Load(coord)
+#define HLSL_AND(a, b) and(a, b)
+#define HLSL_OR(a, b) or(a, b)
+#endif
+
+static uint implLoadTMEM(uint relativeAddress, uint maskAddress, uint orAddress, bool oddRow, uint textureStart, uint rowSize, TMEM_TEXTURE_TYPE TMEM) {
+    const uint rowStart = (relativeAddress / rowSize) * rowSize;
+    const uint wordIndex = (relativeAddress - rowStart) / 4;
+    const uint swapWordIndex = wordIndex ^ 1;
+    const uint finalAddress = select_uint(oddRow,
+        textureStart + rowStart + (swapWordIndex * 4) + (relativeAddress & 0x3),
+        textureStart + relativeAddress);
+    return TMEM_TEXTURE_LOAD(TMEM, int2(((finalAddress & maskAddress) | orAddress) & TMEM_RDP_MASK8, 0));
+}
+
+#define TMEM_LOAD_MASKED(relativeAddress, mask, orAddress) implLoadTMEM(relativeAddress, mask, orAddress, oddRow, address, stride, TMEM)
+#define TMEM_TLUT_LOAD(paletteAddress) TMEM_TEXTURE_LOAD(TMEM, uint2((paletteAddress) & TMEM_RDP_MASK8, 0))
+
+static float4 sampleTMEMIA4(uint pixelValue4bit) {
+    return IA4ToFloat4(pixelValue4bit);
+}
+
+static float4 sampleTMEMI4(uint pixelValue4bit) {
+    return I4ToFloat4(pixelValue4bit);
+}
+
+static float4 sampleTMEMCI4(uint pixelValue4bit, uint palette) {
+    // Not a real format. Loads the palette index as the upper bits of the value.
+    const uint paletteIndex = pixelValue4bit;
+    const uint decodedValue = (palette << 4) | paletteIndex;
+    return I8ToFloat4(decodedValue);
+}
+
+static float4 sampleTMEM4b(uint pixelValue4bit, uint fmt, uint palette) {
+    switch (fmt) {
+    case G_IM_FMT_CI:
+        return sampleTMEMCI4(pixelValue4bit, palette);
+    case G_IM_FMT_IA:
+        return sampleTMEMIA4(pixelValue4bit);
+    case G_IM_FMT_I:
+    case G_IM_FMT_RGBA: // Not a real format. Replicated by observing hardware behavior.
+        return sampleTMEMI4(pixelValue4bit);
+    case G_IM_FMT_YUV:
