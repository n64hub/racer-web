+void ultramodern::det::fire_timers(RDRAM_ARG uint64_t now) {
+    auto& timers = get_det_timers(PASS_RDRAM1);
+    while (!timers.empty() && TO_PTR(OSTimer, *timers.begin())->timestamp <= now) {
